{
  "version": 2,
  "routes": [
    {
      "src": "/api(/.*)?",
      "dest": "/api/index.js"
    },
    {
      "src": "/docs",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "api.promptometer.tech"
        }
      ],
      "dest": "/api/index.js"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.svg"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/llms.txt",
      "dest": "/llms.txt"
    },
    {
      "src": "/llms-full.txt",
      "dest": "/llms-full.txt"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/og-image.svg",
      "dest": "/og-image.svg"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}