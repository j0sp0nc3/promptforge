{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/docs",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "api.promptometer.tech"
        }
      ],
      "destination": "/api/index.js"
    }
  ]
}